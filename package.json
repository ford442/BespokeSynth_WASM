{
  "name": "bespoke-synth-wasm",
  "version": "1.0.0",
  "description": "BespokeSynth WebAssembly - A modular synthesizer for the web",
  "private": true,
  "scripts": {
    "build": "npm run build:wasm && npm run build:webpack",
    "build:wasm": "cd wasm && ./build.sh",
    "build:wasm:debug": "cd wasm && ./build.sh Debug",
    "build:wasm:profile": "cd wasm && ./build.sh Profile",
    "sync:font": "python3 scripts/sync_pixel_font_shader.py",
    "build:webpack": "webpack --mode production",
    "build:web-only": "npm run build:webpack",
    "dev": "webpack serve --mode development",
    "start": "npm run dev",
    "serve": "node scripts/e2e-static-server.js 8000",
    "clean": "rm -rf dist wasm/build wasm/dist",
    "clean:all": "rm -rf dist node_modules wasm/build wasm/dist",
    "lint": "eslint src tests playwright.config.ts",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.tests.json",
    "test:e2e": "playwright test",
    "test:unit": "node wasm/build/release/BespokeSynthWASM_test.js",
    "test:unit:js": "node --experimental-strip-types tests/unit/keyMapping.test.ts && node --experimental-strip-types tests/unit/audioMode.test.ts && node --experimental-strip-types tests/unit/qwertyPiano.test.ts && node --experimental-strip-types tests/unit/scriptSandbox.test.ts && node --experimental-strip-types tests/unit/micCaptureWorklet.test.ts && node --experimental-strip-types tests/unit/engineProcessor.test.ts && node --experimental-strip-types tests/unit/graphMidiOut.test.ts && node --experimental-strip-types tests/unit/noteClock.test.ts && node --experimental-strip-types tests/unit/demoGallery.test.ts",
    "test:exports": "bash scripts/check-wasm-exports.sh",
    "test:size": "python3 scripts/check_wasm_size.py",
    "test:clang-format": "bash scripts/check-clang-format.sh",
    "test:e2e:text": "bash scripts/run-text-e2e.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "keywords": [
    "synthesizer",
    "webassembly",
    "wasm",
    "audio",
    "music",
    "webgpu",
    "modular"
  ],
  "author": "BespokeSynth Contributors",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ford442/BespokeSynth_WASM.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.40.0",
    "@types/emscripten": "^1.39.10",
    "@types/node": "^22.10.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.7"
  },
  "engines": {
    "node": ">=22.6.0",
    "npm": ">=9.0.0"
  }
}
