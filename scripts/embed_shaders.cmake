# Embed WGSL shader files as C++ string constants.
#
# Invoked at build time (see wasm/CMakeLists.txt):
#   cmake -DOUTPUT=<header> -DSHADERS="name1=path1;name2=path2" -P embed_shaders.cmake
#
# Each entry becomes `static const char <name>[] = R"bespoke_wgsl(...)bespoke_wgsl";`.
# The raw-string delimiter must not appear in any shader; this is checked below.

if(NOT DEFINED OUTPUT OR NOT DEFINED SHADERS)
    message(FATAL_ERROR "embed_shaders.cmake: OUTPUT and SHADERS are required")
endif()

set(_delim "bespoke_wgsl")
set(_content "// Generated by scripts/embed_shaders.cmake - do not edit.\n// Sources live in wasm/shaders/*.wgsl.\n#pragma once\n\n")

foreach(_entry IN LISTS SHADERS)
    string(FIND "${_entry}" "=" _eq)
    if(_eq LESS 1)
        message(FATAL_ERROR "embed_shaders.cmake: expected name=path, got '${_entry}'")
    endif()
    string(SUBSTRING "${_entry}" 0 ${_eq} _name)
    math(EXPR _pathStart "${_eq} + 1")
    string(SUBSTRING "${_entry}" ${_pathStart} -1 _path)

    file(READ "${_path}" _src)
    string(FIND "${_src}" ")${_delim}\"" _clash)
    if(NOT _clash EQUAL -1)
        message(FATAL_ERROR "embed_shaders.cmake: ${_path} contains the raw-string delimiter")
    endif()
    string(APPEND _content "static const char ${_name}[] = R\"${_delim}(${_src})${_delim}\";\n\n")
endforeach()

file(WRITE "${OUTPUT}" "${_content}")
